<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:wsam="http://www.w3.org/2007/05/addressing/metadata" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:tns="http://CAMBIAR.namespace/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://schemas.xmlsoap.org/wsdl/" targetNamespace="http://CAMBIAR.namespace/" name="WSServicio">
<types>
<xsd:schema>
<xsd:import namespace="http://CAMBIAR.namespace/" schemaLocation="WSServicio.xsd"/>
</xsd:schema>
</types>
<message name="login">
<part name="parameters" element="tns:login"/>
</message>
<message name="loginResponse">
<part name="parameters" element="tns:loginResponse"/>
</message>
<portType name="WSServicio">
<operation name="login">
<input wsam:Action="http://CAMBIAR.namespace/WSServicio/login" message="tns:login"/>
<output wsam:Action="http://CAMBIAR.namespace/WSServicio/loginResponse" message="tns:loginResponse"/>
</operation>
</portType>
<binding name="WSServicioPortBinding" type="tns:WSServicio">
<soap:binding transport="http://schemas.xmlsoap.org/soap/http" style="document"/>
<operation name="login">
<soap:operation soapAction="http://CAMBIAR.namespace/WSServicio/login"/>
<input>
<soap:body use="literal"/>
</input>
<output>
<soap:body use="literal"/>
</output>
</operation>
</binding>
<service name="WSServicio">
<port name="WSServicioPort" binding="tns:WSServicioPortBinding">
<soap:address location="http://localhost:8080/CAMBIAR_CONTEXTO/CAMBIAR_SERVICIO"/>
</port>
</service>
</definitions>
