<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTP sin cifrar SOLO hacia hosts de desarrollo (Android 9+ lo bloquea por defecto).
  10.0.2.2 = la PC anfitriona vista desde el emulador.
  Telefono fisico: descomentar y poner la IP de la PC en la red local.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- <domain includeSubdomains="false">192.168.1.50</domain> -->
    </domain-config>
</network-security-config>
