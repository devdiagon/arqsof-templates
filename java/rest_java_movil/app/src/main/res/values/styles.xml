<?xml version="1.0" encoding="utf-8"?>
<!-- Componentes de CLIENT_STYLES.md seccion 5. Los layouts solo referencian estos estilos. -->
<resources>

    <style name="Boton.Primario" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/sobre_accion</item>
        <item name="backgroundTint">@color/boton_primario_fondo</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="Boton.Secundario" parent="Boton.Primario">
        <item name="backgroundTint">@color/boton_secundario_fondo</item>
    </style>

    <style name="Panel" parent="">
        <item name="android:background">@drawable/tarjeta_fondo</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Panel.Titulo">
        <item name="android:padding">16dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Panel.Resultado">
        <item name="android:gravity">center</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Etiqueta" parent="">
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Campo" parent="">
        <item name="android:background">@drawable/campo_fondo</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/campo_texto</item>
        <item name="android:textColorHint">@color/campo_placeholder</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Selector" parent="">
        <item name="android:background">@drawable/spinner_fondo</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Zona de estado (docs/CLIENT_STYLES_JAVA.md 5, layout zona_estado): indicador de ocupado y mensaje con barra izquierda. -->
    <style name="Estado.Indicador" parent="">
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Mensaje" parent="Panel">
        <item name="android:paddingStart">16dp</item>
    </style>
</resources>
