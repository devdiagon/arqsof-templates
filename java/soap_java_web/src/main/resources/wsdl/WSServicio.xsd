<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:tns="http://CAMBIAR.namespace/" xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" version="1.0" targetNamespace="http://CAMBIAR.namespace/">

<xs:element name="login" type="tns:login"/>

<xs:element name="loginResponse" type="tns:loginResponse"/>

<xs:complexType name="login">
<xs:sequence>
<xs:element name="usuario" type="xs:string" minOccurs="0"/>
<xs:element name="contrasenia" type="xs:string" minOccurs="0"/>
</xs:sequence>
</xs:complexType>

<xs:complexType name="loginResponse">
<xs:sequence>
<xs:element name="respuesta" type="tns:RespuestaLogin" minOccurs="0"/>
</xs:sequence>
</xs:complexType>

<xs:complexType name="RespuestaBase">
<xs:sequence>
<xs:element name="estado" type="xs:string" minOccurs="0"/>
<xs:element name="codigo" type="xs:string" minOccurs="0"/>
<xs:element name="mensaje" type="xs:string" minOccurs="0"/>
</xs:sequence>
</xs:complexType>

<xs:complexType name="RespuestaLogin">
<xs:complexContent>
<xs:extension base="tns:RespuestaBase">
<xs:sequence>
<xs:element name="token" type="xs:string" minOccurs="0"/>
</xs:sequence>
</xs:extension>
</xs:complexContent>
</xs:complexType>

<xs:complexType name="RespuestaLista">
<xs:complexContent>
<xs:extension base="tns:RespuestaBase">
<xs:sequence>
<xs:element name="elementos" minOccurs="0">
<xs:complexType>
<xs:sequence>
<xs:element name="elemento" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
</xs:sequence>
</xs:complexType>
</xs:element>
</xs:sequence>
</xs:extension>
</xs:complexContent>
</xs:complexType>

</xs:schema>
