<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      DOMINIO: URL COMPLETA del servicio SOAP (sin "?wsdl"): una sola linea decide a que servidor se conecta la app.
      El cliente no asume puerto ni ruta; cada servidor (Java, .NET) publica la suya. Ejemplos, en el emulador:
        Java (Payara) : http://10.0.2.2:8080/CAMBIAR_CONTEXTO/CAMBIAR_SERVICIO
        .NET (Kestrel): http://10.0.2.2:5267/CAMBIAR_RUTA
      10.0.2.2 es la PC anfitriona vista desde el emulador. Telefono fisico: la IP de la PC, y permitir ese host
      en res/xml/network_security_config.xml.
    -->
    <string name="url_servicio" translatable="false">http://10.0.2.2:8080/CAMBIAR_CONTEXTO/CAMBIAR_SERVICIO</string>
</resources>
