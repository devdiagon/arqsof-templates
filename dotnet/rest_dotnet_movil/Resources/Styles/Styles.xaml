<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!-- Estilos de CLIENT_STYLES_DOTNET.md §3 a §5 y §7.1. Las páginas solo referencian estos estilos, nunca valores sueltos.
     Sin sombras, un solo radio (8), tipografía del sistema. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource Fondo}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Texto}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- Tipografía por rol (§3) -->
    <Style x:Key="TituloAplicacion" TargetType="Label">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>
    <Style x:Key="TituloPantalla" TargetType="Label">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style x:Key="EtiquetaCampo" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="TextoMensaje" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="TextoAyuda" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource TextoSecundario}" />
    </Style>

    <!-- Paneles (§5.1, §5.2): Superficie en el acceso; PanelSobreImagen cuando hay imagen debajo -->
    <Style x:Key="PanelSuperficie" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Superficie}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="PanelSobreImagenEstilo" TargetType="Border" BasedOn="{StaticResource PanelSuperficie}">
        <Setter Property="BackgroundColor" Value="{StaticResource PanelSobreImagen}" />
    </Style>

    <!-- Botones (§5.6, §5.7, §7.1) -->
    <Style x:Key="BotonPrimario" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primario}" />
        <Setter Property="TextColor" Value="{StaticResource SobreAccion}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="Padding" Value="24,12" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimarioPresionado}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.6" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="BotonSecundario" TargetType="Button" BasedOn="{StaticResource BotonPrimario}">
        <Setter Property="BackgroundColor" Value="{StaticResource Secundario}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SecundarioPresionado}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.6" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="BotonMenu" TargetType="Button" BasedOn="{StaticResource BotonPrimario}">
        <Setter Property="MinimumHeightRequest" Value="96" />
    </Style>

    <!-- Indicador de progreso (§5.8) -->
    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource Acento}" />
    </Style>

    <!-- Tarjeta de resultado (§5.12, §7.1) -->
    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource CampoFondo}" />
        <Setter Property="Stroke" Value="{StaticResource ContornoTarjeta}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="TarjetaTitulo" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource CampoPlaceholder}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>
    <Style x:Key="TarjetaTexto" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource CampoTexto}" />
    </Style>
    <Style x:Key="TarjetaPie" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource CampoPlaceholder}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
    </Style>
    <Style x:Key="TarjetaDivisor" TargetType="BoxView">
        <Setter Property="Color" Value="{StaticResource DivisorTarjeta}" />
        <Setter Property="HeightRequest" Value="1" />
    </Style>
</ResourceDictionary>
