<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctl="clr-namespace:ec.edu.monster.controlador"
             x:Class="ec.edu.monster.vista.InicioVista"
             x:DataType="ctl:InicioControlador"
             ControlTemplate="{StaticResource PlantillaPagina}"
             Shell.NavBarIsVisible="False">

    <!-- DOMINIO: pantalla de ejemplo. Se reemplaza por las pantallas del dominio. -->
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Border Style="{StaticResource Panel}">
                <Label Text="Inicio" Style="{StaticResource TituloPantalla}" />
            </Border>

            <Button Text="Cerrar sesión" Command="{Binding CerrarSesion}" Style="{StaticResource BotonSecundario}"
                    Margin="0,16,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
