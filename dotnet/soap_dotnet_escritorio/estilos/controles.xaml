<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vista="clr-namespace:ec.edu.monster.vista">
    <!-- Estilos de controles de CLIENT_STYLES_DOTNET.md §5 y §7.3. Solo referencian los recursos de tema.xaml
         (que se carga antes en App.xaml). Un estilo y un pincel nunca comparten clave. -->

    <!-- texto (§3) -->
    <Style x:Key="TituloAplicacion" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
        <Setter Property="FontSize" Value="{StaticResource TamTituloAplicacion}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="TituloPantalla" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
        <Setter Property="FontSize" Value="{StaticResource TamTituloPantalla}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="TextoResultado" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
        <Setter Property="FontSize" Value="{StaticResource TamResultado}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="TextoCuerpo" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
        <Setter Property="FontSize" Value="{StaticResource TamCuerpo}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="EtiquetaCampo" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
        <Setter Property="FontSize" Value="{StaticResource TamEtiqueta}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="TextoMensaje" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
        <Setter Property="FontSize" Value="{StaticResource TamMensaje}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- botones (§5.6, §5.7, §5.11) -->
    <!-- El pincel de "presionado" viaja en Tag para que el secundario reutilice la misma plantilla. -->
    <Style x:Key="BotonPrimario" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource SobreAccion}" />
        <Setter Property="Background" Value="{StaticResource Primario}" />
        <Setter Property="Tag" Value="{StaticResource PrimarioPresionado}" />
        <Setter Property="FontSize" Value="{StaticResource TamBoton}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="MinHeight" Value="{StaticResource AlturaControl}" />
        <Setter Property="Padding" Value="{StaticResource PaddingBoton}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Raiz" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Radio}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="TextAlignment" Value="Center" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <Border x:Name="Foco" CornerRadius="{StaticResource Radio}" BorderThickness="2"
                                BorderBrush="{StaticResource Acento}" IsHitTestVisible="False" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Raiz" Property="Background"
                                    Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Raiz" Property="Background"
                                    Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Foco" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Raiz" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="BotonSecundario" TargetType="Button" BasedOn="{StaticResource BotonPrimario}">
        <Setter Property="Background" Value="{StaticResource Secundario}" />
        <Setter Property="Tag" Value="{StaticResource SecundarioPresionado}" />
    </Style>
    <!-- Botón de la cuadrícula de acciones (§5.11): 96 de alto; la separación de 16 sale de Margin 8 + contenedor con -8 -->
    <Style x:Key="BotonCuadricula" TargetType="Button" BasedOn="{StaticResource BotonPrimario}">
        <Setter Property="Height" Value="{StaticResource AltoBotonCuadricula}" />
        <Setter Property="Margin" Value="8" />
    </Style>

    <!-- campos (§5.3) -->
    <!-- El anillo de foco o de error se superpone: no cambia el tamaño del campo. -->
    <Style x:Key="CajaTexto" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource CampoTexto}" />
        <Setter Property="Background" Value="{StaticResource CampoFondo}" />
        <Setter Property="CaretBrush" Value="{StaticResource CampoTexto}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Acento}" />
        <Setter Property="FontSize" Value="{StaticResource TamCuerpo}" />
        <Setter Property="MinHeight" Value="{StaticResource AlturaControl}" />
        <Setter Property="Padding" Value="{StaticResource PaddingCampo}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid x:Name="Raiz">
                        <!-- Sin Padding en el Border: TextBox y PasswordBox ya lo aplican al área de texto (duplicarlo
                             dejaba los campos de 66 de alto). -->
                        <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radio}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" />
                        </Border>
                        <Border x:Name="Anillo" CornerRadius="{StaticResource Radio}" BorderThickness="0"
                                IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Anillo" Property="BorderThickness" Value="2" />
                            <Setter TargetName="Anillo" Property="BorderBrush" Value="{StaticResource Acento}" />
                        </Trigger>
                        <Trigger Property="vista:AyudaCampo.Invalido" Value="True">
                            <Setter TargetName="Anillo" Property="BorderThickness" Value="2" />
                            <Setter TargetName="Anillo" Property="BorderBrush" Value="{StaticResource Error}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Raiz" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CajaContrasenia" TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{StaticResource CampoTexto}" />
        <Setter Property="Background" Value="{StaticResource CampoFondo}" />
        <Setter Property="CaretBrush" Value="{StaticResource CampoTexto}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Acento}" />
        <Setter Property="FontSize" Value="{StaticResource TamCuerpo}" />
        <Setter Property="MinHeight" Value="{StaticResource AlturaControl}" />
        <Setter Property="Padding" Value="{StaticResource PaddingCampo}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid x:Name="Raiz">
                        <!-- Sin Padding en el Border: TextBox y PasswordBox ya lo aplican al área de texto (duplicarlo
                             dejaba los campos de 66 de alto). -->
                        <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radio}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" />
                        </Border>
                        <Border x:Name="Anillo" CornerRadius="{StaticResource Radio}" BorderThickness="0"
                                IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Anillo" Property="BorderThickness" Value="2" />
                            <Setter TargetName="Anillo" Property="BorderBrush" Value="{StaticResource Acento}" />
                        </Trigger>
                        <Trigger Property="vista:AyudaCampo.Invalido" Value="True">
                            <Setter TargetName="Anillo" Property="BorderThickness" Value="2" />
                            <Setter TargetName="Anillo" Property="BorderBrush" Value="{StaticResource Error}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Raiz" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- paneles (§5.1, §5.2) -->
    <Style x:Key="PanelSuperficie" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Superficie}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radio}" />
        <Setter Property="Padding" Value="{StaticResource PaddingPanelTitulo}" />
    </Style>
    <Style x:Key="PanelSobreImagenEstilo" TargetType="Border" BasedOn="{StaticResource PanelSuperficie}">
        <Setter Property="Background" Value="{StaticResource PanelSobreImagen}" />
    </Style>
    <Style x:Key="PanelMensajeSuperficie" TargetType="Border" BasedOn="{StaticResource PanelSuperficie}">
        <Setter Property="Padding" Value="{StaticResource PaddingPanelMensaje}" />
    </Style>

    <!-- progreso (§5.8) -->
    <Style x:Key="IndicadorProgreso" TargetType="ProgressBar">
        <Setter Property="IsIndeterminate" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource Acento}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="6" />
    </Style>
</ResourceDictionary>
