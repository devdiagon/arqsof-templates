<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tema.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Ventana -->
    <Style x:Key="VentanaBase" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Fondo}" />
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
        <Setter Property="FontFamily" Value="{StaticResource FuenteBase}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Textos (§3) -->
    <Style x:Key="TextoBase" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="TextoTituloApp" TargetType="TextBlock" BasedOn="{StaticResource TextoBase}">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style x:Key="TextoTitulo" TargetType="TextBlock" BasedOn="{StaticResource TextoBase}">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="TextoEtiqueta" TargetType="TextBlock" BasedOn="{StaticResource TextoBase}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="TextoMensaje" TargetType="TextBlock" BasedOn="{StaticResource TextoBase}">
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="TextoResultado" TargetType="TextBlock" BasedOn="{StaticResource TextoBase}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- Paneles (§5.1, §5.2): planos, sin sombra -->
    <Style x:Key="PanelEncabezado" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Superficie}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radio}" />
        <Setter Property="Padding" Value="{StaticResource PaddingPanelTitulo}" />
    </Style>
    <Style x:Key="PanelMensaje" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Superficie}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radio}" />
        <Setter Property="Padding" Value="{StaticResource PaddingPanelMensaje}" />
    </Style>
    <Style x:Key="PanelError" TargetType="Border" BasedOn="{StaticResource PanelMensaje}">
        <Setter Property="BorderBrush" Value="{StaticResource Error}" />
        <Setter Property="BorderThickness" Value="4,0,0,0" />
    </Style>
    <Style x:Key="PanelResultado" TargetType="Border" BasedOn="{StaticResource PanelMensaje}">
        <Setter Property="BorderBrush" Value="{StaticResource Exito}" />
        <Setter Property="BorderThickness" Value="4,0,0,0" />
        <Setter Property="MinHeight" Value="72" />
    </Style>

    <!-- Botones (§5.6, §5.7): plantilla propia porque el estilo por defecto no admite radio -->
    <Style x:Key="BotonPrimario" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource SobreAccion}" />
        <Setter Property="Background" Value="{StaticResource Primario}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="MinHeight" Value="{StaticResource AlturaControl}" />
        <Setter Property="Padding" Value="{StaticResource PaddingBoton}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Raiz" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Transparente}" BorderThickness="2"
                            CornerRadius="{StaticResource Radio}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Raiz" Property="Background" Value="{StaticResource PrimarioPresionado}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Raiz" Property="BorderBrush" Value="{StaticResource Acento}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Raiz" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="BotonSecundario" TargetType="Button" BasedOn="{StaticResource BotonPrimario}">
        <Setter Property="Background" Value="{StaticResource Secundario}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Raiz" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Transparente}" BorderThickness="2"
                            CornerRadius="{StaticResource Radio}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Raiz" Property="Background" Value="{StaticResource SecundarioPresionado}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Raiz" Property="BorderBrush" Value="{StaticResource Acento}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Raiz" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Campos (§5.3): borde de 2 transparente en reposo, Acento con foco, Error si falla la validación -->
    <Style x:Key="CajaTexto" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource CampoTexto}" />
        <Setter Property="CaretBrush" Value="{StaticResource CampoTexto}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="{StaticResource AlturaControl}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Raiz" Background="{StaticResource CampoFondo}"
                            BorderBrush="{StaticResource Transparente}" BorderThickness="2"
                            CornerRadius="{StaticResource Radio}" Padding="10,0">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Raiz" Property="BorderBrush" Value="{StaticResource Acento}" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Raiz" Property="BorderBrush" Value="{StaticResource Error}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Raiz" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CajaContrasenia" TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{StaticResource CampoTexto}" />
        <Setter Property="CaretBrush" Value="{StaticResource CampoTexto}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="{StaticResource AlturaControl}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Raiz" Background="{StaticResource CampoFondo}"
                            BorderBrush="{StaticResource Transparente}" BorderThickness="2"
                            CornerRadius="{StaticResource Radio}" Padding="10,0">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Raiz" Property="BorderBrush" Value="{StaticResource Acento}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Raiz" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Selector (§5.5): flecha #424242 a la derecha; lista con campo-fondo y campo-texto -->
    <Style x:Key="ElementoSelector" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource CampoTexto}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Raiz" Background="{StaticResource CampoFondo}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Raiz" Property="Background" Value="#EDE9FE" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Raiz" Property="Background" Value="#DDD6FE" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Selector" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource CampoTexto}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="{StaticResource AlturaControl}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ElementoSelector}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Raiz" Background="{StaticResource CampoFondo}"
                                BorderBrush="{StaticResource Transparente}" BorderThickness="2"
                                CornerRadius="{StaticResource Radio}" />
                        <ContentPresenter Margin="12,0,40,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False" />
                        <Path Data="M 0 0 L 6 6 L 12 0" Stroke="{StaticResource Flecha}" StrokeThickness="2"
                              Width="12" Height="6" HorizontalAlignment="Right" Margin="0,0,14,0"
                              VerticalAlignment="Center" IsHitTestVisible="False" />
                        <ToggleButton Opacity="0" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                               PopupAnimation="Fade" Focusable="False">
                            <Border Background="{StaticResource CampoFondo}" CornerRadius="{StaticResource Radio}"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="240" Margin="0,4,0,0" ClipToBounds="True">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Raiz" Property="BorderBrush" Value="{StaticResource Acento}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Raiz" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Indicador de progreso (§5.8): indeterminado, en Acento -->
    <Style x:Key="Progreso" TargetType="ProgressBar">
        <Setter Property="IsIndeterminate" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource Acento}" />
        <Setter Property="Background" Value="{StaticResource Borde}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="4" />
    </Style>

</ResourceDictionary>
