<UserControl x:Class="ec.edu.monster.vista.LoginVista"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ec.edu.monster.vista"
             Focusable="False">
    <StackPanel IsEnabled="{Binding Ocupado, Converter={StaticResource Negacion}}">
        <Border Style="{StaticResource PanelEncabezado}">
            <TextBlock Text="{x:Static local:Textos.NombreAplicacion}" Style="{StaticResource TextoTituloApp}" />
        </Border>

        <TextBlock Text="Usuario" Style="{StaticResource TextoEtiqueta}" Margin="0,24,0,6" />
        <TextBox x:Name="Usuario" Style="{StaticResource CajaTexto}"
                 Text="{Binding Usuario, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Contraseña" Style="{StaticResource TextoEtiqueta}" Margin="0,16,0,6" />
        <PasswordBox x:Name="Contrasenia" Style="{StaticResource CajaContrasenia}" />

        <Border Style="{StaticResource PanelError}" Margin="0,16,0,0"
                Visibility="{Binding HayMensaje, Converter={StaticResource BooleanAVisibilidad}}">
            <TextBlock Text="{Binding Mensaje}" Style="{StaticResource TextoMensaje}" />
        </Border>

        <Button Content="Iniciar sesión" Command="{Binding IniciarSesion}" IsDefault="True"
                Style="{StaticResource BotonPrimario}" HorizontalAlignment="Center" Margin="0,24,0,0" />

        <ProgressBar Style="{StaticResource Progreso}" Margin="0,16,0,0"
                     Visibility="{Binding Ocupado, Converter={StaticResource BooleanAVisibilidad}}" />
    </StackPanel>
</UserControl>
