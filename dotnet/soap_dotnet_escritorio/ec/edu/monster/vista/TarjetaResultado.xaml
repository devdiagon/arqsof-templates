<UserControl x:Class="ec.edu.monster.vista.TarjetaResultado"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tarjeta de resultado (CLIENT_STYLES_DOTNET.md §5.12). DataContext: un DatosTarjeta. Blanca en ambas
         presentaciones, plana, de 260 de ancho, con contorno sutil del color primario. -->
    <Border Width="{StaticResource AnchoTarjeta}" Margin="8,0" Padding="16"
            Background="{StaticResource CampoFondo}" CornerRadius="{StaticResource Radio}"
            BorderBrush="{StaticResource ContornoTarjeta}" BorderThickness="1.5">
        <StackPanel>
            <TextBlock Text="{Binding Titulo}" TextAlignment="Center" TextWrapping="Wrap"
                       FontSize="{StaticResource TamCuerpo}" FontWeight="Bold"
                       Foreground="{StaticResource CampoPlaceholder}" />
            <TextBlock Text="{Binding Monto}" Margin="0,8" TextWrapping="Wrap"
                       FontSize="{StaticResource TamTituloPantalla}" FontWeight="Bold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource ExitoClaro}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Suma}" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource ErrorClaro}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Variacion}" TextWrapping="Wrap" FontSize="{StaticResource TamCuerpo}"
                       Foreground="{StaticResource CampoTexto}" />
            <Border Height="1" Margin="0,12,0,0" Background="{StaticResource DivisorTarjeta}" />
            <TextBlock Text="{Binding Pie}" Margin="0,8,0,0" TextAlignment="Right" TextWrapping="Wrap"
                       FontSize="{StaticResource TamMensaje}" Foreground="{StaticResource CampoPlaceholder}" />
        </StackPanel>
    </Border>
</UserControl>
