<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>ec.edu.monster</RootNamespace>
    <!-- Las pruebas (xUnit) viven en este mismo proyecto, en ec/edu/monster/pruebas: el punto de entrada lo genera App.xaml. -->
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- El SDK de WPF no incluye System.Net.Http entre los using implícitos (el de la consola sí): se agrega aquí para que la
       capa api sea idéntica a la de la consola, sin un using explícito en sus archivos. -->
  <ItemGroup>
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <!-- Imagen decorativa (docs/CLIENT_STYLES_DOTNET.md §6, §7.3): PNG con Build Action Resource; sustituirla conservando el nombre. -->
  <ItemGroup>
    <Resource Include="estaticos\fondo_app.png" />
  </ItemGroup>

</Project>
