<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <!-- Tokens de CLIENT_STYLES_DOTNET.md, presentación oscura (§2). Las vistas solo referencian estos nombres. -->

    <!-- Marca y acción (§2.1) -->
    <SolidColorBrush x:Key="Acento" Color="#A78BFA" />
    <SolidColorBrush x:Key="Primario" Color="#6D28D9" />
    <SolidColorBrush x:Key="PrimarioPresionado" Color="#5B21B6" />
    <SolidColorBrush x:Key="Secundario" Color="#4B4563" />
    <SolidColorBrush x:Key="SecundarioPresionado" Color="#3A3550" />
    <SolidColorBrush x:Key="SobreAccion" Color="#FFFFFF" />

    <!-- Presentación oscura (§2.2) -->
    <Color x:Key="ColorFondo">#1A1426</Color>
    <SolidColorBrush x:Key="Fondo" Color="{StaticResource ColorFondo}" />
    <SolidColorBrush x:Key="Superficie" Color="#271D3A" />
    <SolidColorBrush x:Key="PanelSobreImagen" Color="#99000000" />
    <SolidColorBrush x:Key="Texto" Color="#F5F3FF" />
    <SolidColorBrush x:Key="TextoSecundario" Color="#B4A9CE" />
    <SolidColorBrush x:Key="Borde" Color="#3B2D57" />
    <SolidColorBrush x:Key="Error" Color="#F87171" />
    <SolidColorBrush x:Key="Exito" Color="#4ADE80" />

    <!-- Formulario (§2.4) -->
    <SolidColorBrush x:Key="CampoFondo" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CampoTexto" Color="#1E1033" />
    <SolidColorBrush x:Key="CampoPlaceholder" Color="#6B6280" />
    <SolidColorBrush x:Key="CampoBorde" Color="#6B6280" />
    <SolidColorBrush x:Key="FlechaSelector" Color="#424242" />

    <!-- Tarjeta de resultado (§2.5) -->
    <SolidColorBrush x:Key="ExitoClaro" Color="#15803D" />
    <SolidColorBrush x:Key="ErrorClaro" Color="#B91C1C" />
    <SolidColorBrush x:Key="DivisorTarjeta" Color="#D9D2EA" />
    <SolidColorBrush x:Key="ContornoTarjeta" Color="#806D28D9" />

    <!-- Medidas (§4): unidad base 4 -->
    <CornerRadius x:Key="Radio">8</CornerRadius>
    <system:Double x:Key="AlturaControl">36</system:Double>
    <Thickness x:Key="MargenPantalla">24</Thickness>
    <system:Double x:Key="EspacioBloque">16</system:Double>
    <system:Double x:Key="EspacioAccionesSalida">32</system:Double>
    <Thickness x:Key="PaddingBoton">20,8</Thickness>
    <!-- 12 a los lados; el alto lo da AlturaControl (36) -->
    <Thickness x:Key="PaddingCampo">12,6</Thickness>
    <Thickness x:Key="PaddingPanelTitulo">16</Thickness>
    <Thickness x:Key="PaddingPanelMensaje">12</Thickness>
    <system:Double x:Key="SeparacionEtiqueta">6</system:Double>
    <GridLength x:Key="BarraEstado">4</GridLength>

    <!-- Ventana y contenido (§7.0, §7.3) -->
    <system:Double x:Key="VentanaAncho">1100</system:Double>
    <system:Double x:Key="VentanaAlto">720</system:Double>
    <system:Double x:Key="VentanaAnchoMinimo">900</system:Double>
    <system:Double x:Key="VentanaAltoMinimo">640</system:Double>
    <GridLength x:Key="AnchoPanelFormulario">560</GridLength>
    <system:Double x:Key="AnchoColumna">420</system:Double>
    <system:Double x:Key="AnchoContenidoFormulario">480</system:Double>
    <system:Double x:Key="AnchoContenidoAmplio">640</system:Double>

    <!-- Constantes únicas de la imagen decorativa (§6): horizontal, compacta al 60 % -->
    <system:Double x:Key="OpacidadImagen">0.4</system:Double>
    <GridLength x:Key="MargenImagen">0.2*</GridLength>
    <GridLength x:Key="CentroImagen">0.6*</GridLength>

    <!-- Cuadrícula, tarjeta y tabla (§5.11 a §5.13) -->
    <system:Double x:Key="AltoBotonCuadricula">96</system:Double>
    <system:Double x:Key="AnchoTarjeta">260</system:Double>
    <system:Double x:Key="AltoFilaTabla">36</system:Double>

    <!-- Tipografía por rol, escritorio (§3): Segoe UI, solo regular y bold (Medium solo en el resultado) -->
    <FontFamily x:Key="FuenteBase">Segoe UI</FontFamily>
    <system:Double x:Key="TamTituloAplicacion">28</system:Double>
    <system:Double x:Key="TamTituloPantalla">24</system:Double>
    <system:Double x:Key="TamResultado">18</system:Double>
    <system:Double x:Key="TamCuerpo">14</system:Double>
    <system:Double x:Key="TamEtiqueta">13</system:Double>
    <system:Double x:Key="TamMensaje">13</system:Double>
    <system:Double x:Key="TamBoton">15</system:Double>
</ResourceDictionary>
