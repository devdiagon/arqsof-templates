<Application x:Class="ec.edu.monster.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Sin StartupUri: la ventana la crea App.OnStartup al componer la aplicación. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="estilos/tema.xaml" />
                <ResourceDictionary Source="estilos/controles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolAVisibilidad" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
