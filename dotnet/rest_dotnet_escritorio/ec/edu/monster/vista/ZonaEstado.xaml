<UserControl x:Class="ec.edu.monster.vista.ZonaEstado"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:ec.edu.monster.controlador">
    <!-- Zona de estado (CLIENT_STYLES_DOTNET.md §5.14): un solo lugar, bajo los botones, que muestra de uno en uno el
         indicador de ocupado, un error o un éxito. Lee el estado del controlador (DataContext heredado de la pantalla). -->
    <StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Estado}" Value="{x:Static ctrl:EstadoZona.Ocupado}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <ProgressBar Width="160" Style="{StaticResource IndicadorProgreso}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding TextoOcupado}" Style="{StaticResource TextoMensaje}" Margin="12,0,0,0"
                       VerticalAlignment="Center" />
        </StackPanel>

        <Border CornerRadius="{StaticResource Radio}" ClipToBounds="True"
                Background="{Binding Fondo, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Estado}" Value="{x:Static ctrl:EstadoZona.Error}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Estado}" Value="{x:Static ctrl:EstadoZona.Exito}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource BarraEstado}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Barra izquierda de 4: obligatoria en la zona de estado -->
                <Border Grid.Column="0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource Error}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Estado}" Value="{x:Static ctrl:EstadoZona.Exito}">
                                    <Setter Property="Background" Value="{StaticResource Exito}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Mensaje}" Style="{StaticResource TextoMensaje}"
                           Margin="12" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
