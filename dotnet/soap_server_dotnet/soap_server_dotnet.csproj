<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CoreWCF.Http" Version="1.9.1" />
    <PackageReference Include="CoreWCF.Primitives" Version="1.9.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <!-- WebApplicationFactory<Program> necesita ubicar la raíz de contenido. Como las pruebas están en el mismo proyecto
       (no hay ProjectReference que genere el manifiesto), se escribe aquí, en la carpeta de salida, tras cada compilación. -->
  <Target Name="EscribirManifiestoMvcTesting" AfterTargets="Build">
    <WriteLinesToFile File="$(OutDir)MvcTestingAppManifest.json" Overwrite="true"
                      Lines="{ &quot;$(AssemblyName), Version=1.0.0.0, Culture=neutral, PublicKeyToken=null&quot;: &quot;$(MSBuildProjectDirectory.Replace('\', '/'))&quot; }" />
  </Target>

</Project>