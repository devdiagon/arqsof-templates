<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ec.edu.monster.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vista="clr-namespace:ec.edu.monster.vista"
    Title="{x:Static vista:Textos.NombreAplicacion}"
    FlyoutBehavior="Disabled"
    NavBarIsVisible="False">

    <!-- Pantalla inicial; las demás se registran como rutas en AppShell.xaml.cs -->
    <ShellContent Route="login" ContentTemplate="{DataTemplate vista:LoginVista}" />

</Shell>
