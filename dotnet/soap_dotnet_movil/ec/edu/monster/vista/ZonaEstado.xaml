<?xml version="1.0" encoding="UTF-8" ?>
<ContentView x:Class="ec.edu.monster.vista.ZonaEstado"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="Raiz"
             IsVisible="False">
    <!-- Zona de estado (CLIENT_STYLES_DOTNET.md §5.14, §7.1): un solo lugar bajo los botones con tres contenidos
         excluyentes: ocupado (indicador + texto), error o éxito (panel con barra izquierda de 4). El texto es siempre el
         mensaje del sistema, nunca un código. Visibilidad según el Estado del controlador (lo fija el código). -->
    <Grid>
        <Border x:Name="PanelOcupado" IsVisible="False" Style="{StaticResource PanelSuperficie}" Padding="12">
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <ActivityIndicator IsRunning="True" HeightRequest="40" WidthRequest="40" HorizontalOptions="Center" />
                <Label Text="{Binding TextoOcupado}" Style="{StaticResource TextoMensaje}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Border>

        <Border x:Name="PanelMensaje" IsVisible="False" Style="{StaticResource PanelSuperficie}" Padding="0">
            <Grid ColumnDefinitions="4,*">
                <BoxView x:Name="Barra" Grid.Column="0" Color="{StaticResource Error}" />
                <Label Grid.Column="1" Text="{Binding Mensaje}" Style="{StaticResource TextoMensaje}" Margin="12" />
            </Grid>
        </Border>
    </Grid>
</ContentView>
