<?xml version="1.0" encoding="utf-8" ?>
<!-- Panel de mensaje de error o validación (CLIENT_STYLES_DOTNET §5.2): barra de 4 en «Error» a la izquierda y solo el texto. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vista="clr-namespace:ec.edu.monster.vista"
             x:Class="ec.edu.monster.vista.PanelMensaje"
             x:DataType="vista:PanelMensaje"
             x:Name="Raiz">
    <Border Style="{StaticResource Panel}" Padding="0">
        <Grid ColumnDefinitions="4,*">
            <BoxView Color="{StaticResource Error}" />
            <Label Grid.Column="1" Padding="12" Text="{Binding Texto, Source={x:Reference Raiz}}" Style="{StaticResource Mensaje}" />
        </Grid>
    </Border>
</ContentView>
