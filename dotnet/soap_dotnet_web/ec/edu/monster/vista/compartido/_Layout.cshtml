<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Titulo"] - @Textos.NombreAplicacion</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/css/estilos.css" asp-append-version="true" />
</head>
<body class="tema-oscuro">
    @* Disposición dividida (CLIENT_STYLES_DOTNET.md §7.0) con las zonas invertidas, igual que el cliente de escritorio:
       imagen a la izquierda (560 fijo) y la pantalla actual a la derecha, en una columna de 420 centrada.
       La imagen es del layout, no de cada pantalla. *@
    <div class="pagina">
        <div class="zona-imagen" aria-hidden="true"></div>
        <main class="zona-contenido">
            <div class="columna">
                @RenderBody()
            </div>
        </main>
    </div>
    <script src="~/js/app.js" asp-append-version="true"></script>
</body>
</html>
